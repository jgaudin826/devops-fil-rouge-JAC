# The port for runing the api
PORT=
# The JWT key for authentication
JWT_SECRET_KEY=

# Postgres Database Connection Parameters
# Used in docker-compose
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Postgres Database Connection String
# Used locally
CONNECTION_STRING=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable&TimeZone=UTC 